NODE_ENV=development
PORT=4500
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/campusly
MONGODB_TEST_URI=mongodb://localhost:27017/campusly-test
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=your-access-secret-key
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_RESET_SECRET=your-reset-secret-key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:3500,http://127.0.0.1:3500
APP_NAME=Campusly
APP_URL=http://localhost:3500
API_BASE_URL=http://localhost:4500

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@campusly.co.za
SMTP_PASS=your-smtp-password
EMAIL_FROM=Campusly <noreply@campusly.co.za>
RESEND_API_KEY=

SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://api.sms-provider.co.za
SMS_SENDER_ID=Campusly
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Rate Limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# File Upload
MAX_FILE_SIZE=10485760

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Firebase Push Notifications
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit Classroom
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_EGRESS_ENABLED=false

# Paper Diagrams / Uploads
TIKZ_RENDERER_URL=http://localhost:3600
UPLOAD_DIR=uploads

# OneGate Payment Gateway (Callpay-powered, SA)
ONEGATE_BASE_URL=https://payments.onegate.co.za
ONEGATE_ORG_ID=
ONEGATE_SALT=

# OneGate (Callpay) — payment gateway for subscriptions
ONEGATE_WEBHOOK_PATH=/api/webhooks/onegate
ONEGATE_IP_ALLOWLIST=
SUBSCRIPTION_CRON_ENABLED=true
FRONTEND_BASE_URL=http://localhost:3500
BACKEND_BASE_URL=http://localhost:4500
